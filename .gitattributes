# Normalize line endings in the Git index.
# Text files are stored with LF and checked out according to each
# machine's native setting (CRLF on Windows with core.autocrlf=true).
* text=auto

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.zip binary
*.exe binary
*.dll binary
*.pdf binary
*.woff binary
*.woff2 binary
